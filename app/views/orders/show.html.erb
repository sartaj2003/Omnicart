<h1 style="margin-bottom:20px;">🧾 Order Confirmation</h1>

<div style="
  border:1px solid #e5e7eb;
  padding:20px;
  border-radius:10px;
  margin-bottom:30px;
  background:#fafafa;
">
  <p><strong>Order ID:</strong> <%= @order.id %></p>
  <p><strong>Customer Name:</strong> <%= @order.customer_name %></p>
  <p><strong>Address:</strong> <%= @order.address %></p>
  <p><strong>Payment Method:</strong> <%= @order.payment_method %></p>
  <p>
    <strong>Status:</strong>
    <span style="
      padding:5px 10px;
      border-radius:6px;
      background:#d1fae5;
      color:#065f46;
      font-weight:bold;
    ">
      <%= @order.status || "Pending" %>
    </span>
  </p>
</div>


<h2 style="margin-bottom:15px;">🛍 Order Items</h2>

<table style="
  width:100%;
  border-collapse:collapse;
  background:white;
  box-shadow:0 4px 10px rgba(0,0,0,0.05);
">
  <thead style="background:#f3f4f6;">
    <tr>
      <th style="padding:12px; border-bottom:1px solid #e5e7eb;">Product</th>
      <th style="padding:12px; border-bottom:1px solid #e5e7eb;">Quantity</th>
      <th style="padding:12px; border-bottom:1px solid #e5e7eb;">Unit Price</th>
      <th style="padding:12px; border-bottom:1px solid #e5e7eb;">Total</th>
    </tr>
  </thead>

  <tbody>
    <% @order.order_items.each do |item| %>
      <tr>
        <td style="padding:12px; border-bottom:1px solid #eee;">
          <%= item.product.name %>
        </td>

        <td style="padding:12px; border-bottom:1px solid #eee;">
          <%= item.quantity %>
        </td>

        <td style="padding:12px; border-bottom:1px solid #eee;">
          <%= number_to_currency(item.price_cents / 100.0, unit: "₹") %>
        </td>

        <td style="padding:12px; border-bottom:1px solid #eee;">
          <%= number_to_currency((item.price_cents * item.quantity) / 100.0, unit: "₹") %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>


<div style="
  margin-top:30px;
  text-align:right;
  font-size:20px;
  font-weight:bold;
">
  Grand Total:
  <%= number_to_currency(@order.total_amount.to_i / 100.0, unit: "₹") %>
</div>


<div style="margin-top:40px;">
  <%= link_to "🛒 Continue Shopping",
      root_path,
      style:"
        background:black;
        color:white;
        padding:12px 18px;
        border-radius:8px;
        text-decoration:none;
        font-weight:bold;
      "
  %>
</div>
