<h1 style="text-align:center;">🛒 Omnicart Store</h1>

<!-- SEARCH -->
<div style="text-align:center; margin-bottom:20px;">
<%= form_with url: products_path, method: :get, local: true do %>
  <%= text_field_tag :search, params[:search],
      placeholder: "Search products...",
      style:"padding:8px; width:250px;" %>

  <%= submit_tag "Search",
      style:"padding:8px 15px; background:black; color:white;" %>
<% end %>
</div>

<!-- CATEGORY -->
<div style="text-align:center; margin-bottom:30px;">
<%= form_with url: products_path, method: :get, local: true do %>

  <%= select_tag :category_id,
      options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
      prompt: "All Categories",
      style:"padding:8px; width:200px;" %>

  <%= submit_tag "Filter",
      style:"padding:8px 15px; background:green; color:white;" %>
<% end %>
</div>

<!-- PRODUCTS GRID -->
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:20px; padding:20px;">

<% @products.each do |product| %>

<div style="border:1px solid #ddd; padding:15px; border-radius:10px; text-align:center; background:white;">

  <!-- IMAGE -->
  <% if product.image.attached? %>
    <%= image_tag product.image,
        style:"width:100%; height:200px; object-fit:contain; background:#f6f6f6; padding:10px;" %>
  <% else %>
    <img src="https://via.placeholder.com/300"
         style="width:100%; height:200px; object-fit:contain;">
  <% end %>

  <!-- NAME -->
  <h3><%= product.name %></h3>

  <!-- DESC -->
  <p style="color:gray;">
  <%= truncate(product.description, length: 60) %>
  </p>

  <!-- PRICE -->
  <h3 style="color:green;">
  ₹ <%= product.price_cents %>
  </h3>

  <!-- STOCK -->
  <% if product.stock > 0 %>
    <p style="color:green;">In Stock</p>
  <% else %>
    <p style="color:red;">Out of Stock</p>
  <% end %>

  <!-- ADD TO CART -->
  <%= button_to "Add to Cart",
      cart_cart_items_path(product_id: product.id),
      method: :post,
      style:"padding:10px 20px; background:black; color:white; border:none; border-radius:6px;" %>

</div>

<% end %>
</div>
