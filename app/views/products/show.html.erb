<h1><%= @product.name %></h1>

<div class="product-image">
  <% if @product.image.attached? %>
    <%= image_tag @product.image, alt: @product.name, width: 300 %>
  <% else %>
    <p>No image available</p>
  <% end %>
</div>

<p><strong>Description:</strong> <%= @product.description %></p>
<p><strong>Price:</strong> <%= number_to_currency(@product.price) %></p>
<p><strong>Stock:</strong> <%= @product.stock_quantity %></p>

<%= link_to 'Add to Cart', add_to_cart_path(@product), method: :post, class: 'button' %>
<%= link_to 'Back to Products', products_path, class: 'button' %>